<Window x:Class="TimelapseConverter.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="미리보기 · TimeLapse Converter"
        Width="880" Height="668" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="Assets/app.ico"
        ShowInTaskbar="False">
    <Grid Margin="22,16,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="미리보기" FontSize="17" FontWeight="Bold"/>
            <TextBlock x:Name="CaptionText" Margin="0,3,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="12" Background="#16181C" Padding="2">
            <Grid>
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
                              ScrubbingEnabled="True"
                              MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed"/>
                <TextBlock x:Name="PlayerMessage" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#C9C6BE" TextAlignment="Center" TextWrapping="Wrap" Margin="30"
                           Text="불러오는 중…"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="22,9" FontSize="13"
                    Content="닫기" Click="Close_Click" IsCancel="True"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PlayPauseButton" Style="{StaticResource SecondaryButton}" Click="PlayPause_Click" MinWidth="104">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PlayPauseIcon" Text="&#xE769;" Style="{StaticResource Icon}"/>
                        <TextBlock x:Name="PlayPauseText" Text="일시정지" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Padding="12,8"
                        Content="기본 플레이어로 열기" Click="OpenExternal_Click"/>
                <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{StaticResource TextMutedBrush}" Text="반복 재생 중 · 실제 저장 결과와 같은 방식으로 변환한 샘플"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
