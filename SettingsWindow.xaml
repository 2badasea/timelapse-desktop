<Window x:Class="TimelapseConverter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정 · TimeLapse Converter"
        Width="580" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="Assets/app.ico"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SectionHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,3,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,20">
        <TextBlock Text="설정" FontSize="19" FontWeight="Bold"/>
        <TextBlock Text="변경 내용은 바로 저장됩니다" FontSize="12" Margin="0,2,0,16"
                   Foreground="{StaticResource TextMutedBrush}"/>

        <ContentControl Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
                <!-- 저장 폴더 -->
                <TextBlock Text="저장 폴더" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="변환된 타임랩스 영상이 만들어지는 폴더입니다." Style="{StaticResource SectionHint}"/>
                <Border Style="{StaticResource PathBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock x:Name="OutputFolderText" Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center"
                                   FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="변경" Click="ChangeOutput_Click"/>
                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Content="열기"
                                Click="OpenOutput_Click"/>
                    </Grid>
                </Border>
                <Button x:Name="ResetOutputButton" Style="{StaticResource GhostButton}" BorderThickness="0" Padding="2,4"
                        HorizontalAlignment="Left" Margin="0,6,0,0" Click="ResetOutput_Click"/>

                <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,14"/>

                <!-- 녹화 폴더 -->
                <TextBlock Text="녹화 폴더" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="메인 화면 왼쪽 목록에 영상 파일을 보여줄 폴더입니다. (OBS 녹화 경로)" Style="{StaticResource SectionHint}"/>
                <Border Style="{StaticResource PathBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="SourceFolderText" Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center"
                                   FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="변경" Click="ChangeSource_Click"/>
                    </Grid>
                </Border>

                <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,14"/>

                <!-- 임시 파일 -->
                <TextBlock Text="임시 파일" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="TempHintText" Style="{StaticResource SectionHint}"/>
                <Border Style="{StaticResource StatBox}" Padding="14,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="폴더 열기" Click="OpenTemp_Click"/>
                            <Button x:Name="CleanTempButton" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                    Click="CleanTemp_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                    <TextBlock Text="지금 정리" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="TempUsageText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </DockPanel>
                </Border>

                <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,14"/>

                <!-- 변환 엔진 -->
                <TextBlock Text="변환 엔진" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="GpuHintText" Style="{StaticResource SectionHint}"/>
                <CheckBox x:Name="GpuSwitch" Style="{StaticResource Switch}" Content="NVIDIA GPU 가속 사용"
                          Click="GpuSwitch_Click" Margin="0,0,0,12"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="FFmpeg 위치 지정"
                            Click="ChangeFfmpeg_Click"/>
                    <TextBlock x:Name="FfmpegText" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}"/>
                </DockPanel>
            </StackPanel>
        </ContentControl>

        <DockPanel Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="닫기"
                    Padding="26,9" FontSize="13" IsCancel="True" IsDefault="True" Click="Close_Click"/>
            <TextBlock x:Name="VersionText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"/>
        </DockPanel>
    </StackPanel>
</Window>
