<Window x:Class="TimelapseConverter.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="업데이트 · TimeLapse Converter"
        Width="540" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="Assets/app.ico"
        ShowInTaskbar="False">

    <StackPanel Margin="22,18,22,20">
        <DockPanel>
            <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentSoftBrush}">
                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="19" HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="새 버전이 있습니다" FontSize="19" FontWeight="Bold"/>
                <TextBlock x:Name="VersionText" FontSize="12.5" Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </DockPanel>

        <ContentControl Style="{StaticResource Card}" Padding="20,16" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="바뀐 내용" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12.5" LineHeight="20" Margin="0,0,6,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </ScrollViewer>
            </StackPanel>
        </ContentControl>

        <StackPanel x:Name="ProgressPanel" Margin="2,16,2,0" Visibility="Collapsed">
            <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="ProgressDetailText" DockPanel.Dock="Right" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock x:Name="ProgressText" FontSize="12.5" FontWeight="SemiBold"/>
            </DockPanel>
            <ProgressBar x:Name="Progress" Style="{StaticResource ConvertProgress}" Minimum="0" Maximum="100"/>
        </StackPanel>

        <Border x:Name="MessagePanel" Margin="0,16,0,0" CornerRadius="10" BorderThickness="1" Padding="14,12"
                Visibility="Collapsed">
            <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <TextBlock x:Name="HintText" Margin="2,14,0,0" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="업데이트하면 프로그램이 잠깐 꺼졌다가 새 버전으로 다시 켜집니다. 설정과 변환한 영상은 그대로예요."/>

        <DockPanel Margin="0,18,0,0">
            <Button x:Name="PageButton" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="릴리스 페이지"
                    VerticalAlignment="Center" Click="Page_Click" ToolTip="GitHub 릴리스 페이지를 엽니다"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" Style="{StaticResource SecondaryButton}" Content="나중에" Padding="18,9"
                        Click="Later_Click"/>
                <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Padding="20,9" FontSize="13"
                        Margin="8,0,0,0" Click="Install_Click" IsDefault="True"
                        AutomationProperties.AutomationId="InstallButton" AutomationProperties.Name="지금 업데이트">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13"/>
                        <TextBlock x:Name="InstallText" Text="지금 업데이트" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
